<?xml version="1.0"?>
<ruleset name="ElasticPress-French-Addon">
	<description>Coding Standards for ElasticPress French Addon</description>

	<!-- Scan all files in directory -->
	<file>.</file>

	<!-- Scan only PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Ignore non-plugin / development paths -->
	<exclude-pattern>bin/</exclude-pattern>
	<exclude-pattern>languages/</exclude-pattern>
	<exclude-pattern>tests/</exclude-pattern>
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>wordpress/</exclude-pattern>
	<exclude-pattern>.ddev/</exclude-pattern>
	<exclude-pattern>.wordpress-org/</exclude-pattern>

	<!-- Show colors in console -->
	<arg value="-colors"/>

	<!-- Show sniff codes in all reports -->
	<arg value="ns"/>

	<!-- Show progress. -->
	<arg value="p"/>

	<!-- Set ini. -->
	<ini name="memory_limit" value="512M"/>
	<ini name="max_execution_time" value="-1"/>

	<!-- Use WordPress Extra as a base -->
	<rule ref="WordPress-Extra">
		<!-- Exclude as we use namespaced classes with WP-style file names. -->
		<exclude name="WordPress.Files.FileName"/>

		<!-- Exclude as it conflicts with @var declaration. -->
		<exclude name="Squiz.PHP.CommentedOutCode"/>

		<!-- Exclude as we use custom naming for our class. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- Allow short syntax arrays. -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- Exclude Universal rule that disallows short array syntax. -->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>

	<!-- Allow short ternary operator (?:). -->
	<rule ref="Universal.Operators.DisallowShortTernary">
		<severity>0</severity>
	</rule>

	<config name="minimum_supported_wp_version" value="6.5"/>

	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="elasticpress-french-addon"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

</ruleset>
